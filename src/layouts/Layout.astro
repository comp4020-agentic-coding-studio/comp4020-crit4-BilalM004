---
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Replace this with one sentence saying what this page is. A search result and a link preview both show it." } = Astro.props;

// build.format "preserve" (astro.config.ts) ships this page's own file name
// (index.html, examples.html, ...) as the last path segment, so comparing
// against that -- rather than the full pathname -- survives the base path.
const currentFile = Astro.url.pathname.replace(/\/$/, "").split("/").pop();
const isCurrent = (file: string) => currentFile === file || (file === "index.html" && !currentFile);
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta
      name="description"
      content={description}
    />

    <!--
      The link-preview card: public/card.png, 1200x630 --- replace it. The URL
      resolves against this page, like any link. No og:title/og:description:
      scrapers fall back to the <title> and description above.
    -->
    <meta property="og:type" content="website" />
    <meta property="og:image" content="/comp4020-crit4-BilalM004/card.png" />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- Display face for headings only; body text stays system-ui. -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <header class="site-header">
      <nav aria-label="Primary">
        <a href="./" aria-current={isCurrent("index.html") ? "page" : undefined}>Play</a>
        <a href="./examples.html" aria-current={isCurrent("examples.html") ? "page" : undefined}>Examples</a>
        <a href="./learn.html" aria-current={isCurrent("learn.html") ? "page" : undefined}>Learn</a>
      </nav>
    </header>
    <slot />
  </body>
</html>
