---
import Layout from "../layouts/Layout.astro";
import VideoCard from "../components/VideoCard.astro";
---

<Layout
  title="Famous Examples"
  description="Handpan covers worth a listen -- what the instrument sounds like in someone else's hands."
>
  <main>
    <div class="hero">
      <h1>Famous Examples</h1>
      <p class="tagline">What the handpan sounds like in someone else's hands.</p>
    </div>
    <div class="video-grid">
      <VideoCard
        id="lDQef_S3cy4"
        title="C418 - Aria Math (Handpan Cover)"
        author="Atakan Teoman"
        url="https://www.youtube.com/watch?v=lDQef_S3cy4"
      />
      <VideoCard
        id="uwEaQk5VeS4"
        title="Calming Meditation | 1 hour handpan music"
        author="Malte Marten"
        url="https://youtu.be/uwEaQk5VeS4"
      />
    </div>
  </main>
</Layout>
